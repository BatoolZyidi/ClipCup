# ==============================================================================
# Clip Cup - Environment Configuration Template
# Copy this file to .env and supply your credentials.
# ==============================================================================

# Django settings
SECRET_KEY=django-insecure-change-this-in-production-clipcup-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# Database (Supabase PostgreSQL — leave blank to fall back to local SQLite)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=

# Optional API Key Authentication for backend endpoints
CLIP_CUP_API_KEY=

# AssemblyAI Speech-to-Text
ASSEMBLYAI_API_KEY=

# AWS Credentials & S3 Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_BUCKET_NAME=clipcup-processed-videos

# AWS Bedrock LLM
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Pipeline Configuration
JOB_TIMEOUT_SECONDS=900
MODEL_PATH=backend/models/face_detection_yunet_2023mar.onnx

# Allow mock fallback for local testing when cloud API keys are absent
ALLOW_MOCK_FALLBACK=True

# ---------------------------------------------------------------------------
# Frontend (Vercel) — set this in Vercel's environment variable dashboard
# Set to your Render backend URL, e.g. https://clipcup-backend.onrender.com
# Leave empty for local development (Vite dev proxy handles /api/* locally)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=

